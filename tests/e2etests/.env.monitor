# EBHH Feature Request, see RT #265430

# tine URL and login credentials (if different to .env):
#TEST_URL=
#TEST_USERNAME=
#TEST_PASSWORD=

# More generous Timeout values for external pages.
MONITOR_TIMEOUT_POPUP_OPEN=30000
MONITOR_TIMEOUT_NETWORK_TIMEOUT=30000
MONITOR_TIMEOUT_NETWORK_IDLE=3000

# Defines which Bookmark links to open and how the loaded target page should look like:
# name = Name of the Bookmark (exact match, not just part of the name).
# timeout = Total timeout in ms to wait for the target page to be fully loaded, including redirects.
# optional: selector = DOM selector to match on the fully loaded target page.
# optional: urlStartsWith = Assure the target page (after all redirects) matches an expected URL. No placeholders and no regex.
#MONITOR_BOOKMARKS_JSON='{"targets": [{"name": "Bookmark 1 Name", "timeout": 10000, "selector": "body.mypage1", "urlStartsWith": "https://my-bookmarked-page-1.net/"}, {"name": "Bookmark 2 Name", "timeout": 20000, "urlStartsWith": "https://my-bookmarked-page-2.net/"}]}'
