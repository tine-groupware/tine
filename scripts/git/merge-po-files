#!/bin/sh
#
# Three-way merge driver for PO files
# usage:
#   git config merge.pofile.driver "tine20/scripts/git/merge-po-files %A %O %B"
#
# Merges on message level (msgctxt + msgid):
#  - messages changed on one side only are taken from that side
#  - messages added on either side are added
#  - messages removed on one side are removed (unless changed on the other side)
#  - messages changed differently on both sides are conflicts (msgcat markers, exit 1)
# Obsolete messages ("#~", the gettext graveyard) are dropped.
#
set -e

# given a file, find the path that matches its contents
show_file() {
  hash=`git hash-object "${1}"`
  git ls-tree -r HEAD | fgrep "$hash" | cut -b54-
}

# wraps msgmerge with default options
m_msgmerge() {
  msgmerge --no-wrap --force-po --quiet --no-fuzzy-matching "$@"
}

# wraps msgcat with default options
m_msgcat() {
  msgcat --no-wrap --force-po "$@"
}

# wraps msgattrib with default options
m_msgattrib() {
  msgattrib --no-wrap --force-po "$@"
}

# select messages with a conflict marker
# pass -v to inverse selection
grep_conflicts() {
  msggrep --no-wrap "$@" --msgstr -F -e '#-#-#' -
}

# select messages from $1 that are also in $2 but whose contents have changed
extract_changes() {
  msgcat --no-wrap -o - $1 $2 \
    | grep_conflicts \
    | m_msgmerge -o - $1 - \
    | m_msgattrib --no-obsolete -
}

# select messages from $1 that are not in $2
subtract() {
  msgcomm --no-wrap --force-po --less-than=2 -o - $1 $2 \
    | msgcomm --no-wrap --force-po --more-than=1 -o - - $1
}

# see https://git-scm.com/docs/gitattributes#_performing_a_three_way_merge
# current version %A
LOCAL=$1
# common ancestor’s version %O
BASE=$2
# other branches' version %B
REMOTE=$3

# git only takes the result from %A
OUTPUT=$LOCAL

TEMP=`mktemp /tmp/merge-po.XXXX`

echo "Using custom PO merge driver (`show_file ${LOCAL}`; $TEMP)"

# Extract the PO header from the current branch (top of file until first empty line)
sed -e '/^$/q' < $LOCAL > ${TEMP}.header

# clean input files: one entry per message, active messages only
for v in base:${BASE} local:${LOCAL} remote:${REMOTE}; do
  msguniq --no-wrap --force-po --use-first ${v#*:} | m_msgattrib --no-obsolete -o ${TEMP}.${v%%:*} -
done

# messages changed on local
extract_changes ${TEMP}.local ${TEMP}.base > ${TEMP}.local-changes

# messages changed on remote
extract_changes ${TEMP}.remote ${TEMP}.base > ${TEMP}.remote-changes

# unchanged messages
m_msgcat -o - ${TEMP}.base ${TEMP}.local ${TEMP}.remote \
  | grep_conflicts -v \
  > ${TEMP}.unchanged

# messages changed on both local and remote (conflicts)
m_msgcat -o - ${TEMP}.remote-changes ${TEMP}.local-changes \
  | grep_conflicts \
  > ${TEMP}.conflicts

# messages changed on local, not on remote; and vice-versa
m_msgcat -o ${TEMP}.local-only  --unique ${TEMP}.local-changes  ${TEMP}.conflicts
m_msgcat -o ${TEMP}.remote-only --unique ${TEMP}.remote-changes ${TEMP}.conflicts

# the big merge
m_msgcat -o ${TEMP}.merge1 ${TEMP}.unchanged ${TEMP}.conflicts ${TEMP}.local-only ${TEMP}.remote-only

# messages removed on local or remote
subtract ${TEMP}.base ${TEMP}.local  > ${TEMP}.local-removed
subtract ${TEMP}.base ${TEMP}.remote > ${TEMP}.remote-removed
m_msgcat -o - --use-first ${TEMP}.local-removed ${TEMP}.remote-removed > ${TEMP}.removed-all
# changed messages are kept even if removed on the other side
m_msgcat -o ${TEMP}.changes --use-first ${TEMP}.local-changes ${TEMP}.remote-changes
subtract ${TEMP}.removed-all ${TEMP}.changes > ${TEMP}.removed

# messages still in use: those on local or remote, minus the removed ones
# (messages added on both sides with different translations get conflict markers here)
m_msgcat -o ${TEMP}.union ${TEMP}.local ${TEMP}.remote
subtract ${TEMP}.union ${TEMP}.removed > ${TEMP}.used
m_msgcat -o ${TEMP}.template --use-first ${TEMP}.header ${TEMP}.used

# filter the merge by the template, drop what msgmerge sends to the graveyard
m_msgmerge -o - ${TEMP}.merge1 ${TEMP}.template | m_msgattrib --no-obsolete -o ${TEMP}.merge2 -

# final merge, adds saved header
m_msgcat -o ${OUTPUT} --use-first ${TEMP}.header ${TEMP}.merge2

# check for conflicts
if grep '#-#' $OUTPUT > /dev/null ; then
  echo "Conflict(s) detected"
  echo "   between ${TEMP}.local and ${TEMP}.remote"
  exit 1
fi
rm -f ${TEMP}*
exit 0
